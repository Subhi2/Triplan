{
  "name": "bike-travelling-guide",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:import-osm": "tsx --env-file=.env.local scripts/import-osm.ts",
    "db:import-photos": "tsx --env-file=.env.local scripts/import-photos.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "check:pins": "tsx --env-file=.env.local scripts/check-pins.ts",
    "fixtures:routes": "tsx --env-file=.env.local scripts/record-route-fixtures.ts",
    "fixtures:photon": "tsx --env-file=.env.local scripts/record-photon-fixtures.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@serwist/next": "^9.2.1",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "@vis.gl/react-google-maps": "^1.10.1",
    "drizzle-orm": "^0.44.5",
    "fast-png": "^8.0.0",
    "maplibre-gl": "^5.7.3",
    "mediabunny": "^1.61.0",
    "next": "^15.5.4",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-map-gl": "^8.0.4",
    "suncalc": "^1.9.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/geojson": "^7946.0.16",
    "@types/google.maps": "^3.66.4",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/suncalc": "^1.9.2",
    "dotenv": "^17.2.2",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "serwist": "^9.2.1",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
